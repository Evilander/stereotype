{
  "name": "iat_attributes",
  "description": "Attribute and target word sets from the Word Embedding Association Test, which reproduces the Implicit Association Test stimuli.",
  "source": "Caliskan, A., Bryson, J. J. & Narayanan, A. (2017). Semantics derived automatically from language corpora contain human-like biases. Science 356(6334), supplementary materials; original stimuli from Greenwald, McGhee & Schwartz (1998) and Nosek, Banaji & Greenwald (2002).",
  "url": "https://www.science.org/doi/10.1126/science.aal4230",
  "sets": {
    "pleasant": ["caress", "freedom", "health", "love", "peace", "cheer", "friend", "heaven", "loyal", "pleasure", "diamond", "gentle", "honest", "lucky", "rainbow", "diploma", "gift", "honor", "miracle", "sunrise", "family", "happy", "laughter", "paradise", "vacation"],
    "unpleasant": ["abuse", "crash", "filth", "murder", "sickness", "accident", "death", "grief", "poison", "stink", "assault", "disaster", "hatred", "pollute", "tragedy", "divorce", "jail", "poverty", "ugly", "cancer", "kill", "rotten", "vomit", "agony", "prison"],
    "pleasant_short": ["joy", "love", "peace", "wonderful", "pleasure", "friend", "laughter", "happy"],
    "unpleasant_short": ["agony", "terrible", "horrible", "nasty", "evil", "war", "awful", "failure"],
    "career": ["executive", "management", "professional", "corporation", "salary", "office", "business", "career"],
    "family": ["home", "parents", "children", "family", "cousins", "marriage", "wedding", "relatives"],
    "math": ["math", "algebra", "geometry", "calculus", "equations", "computation", "numbers", "addition"],
    "arts": ["poetry", "art", "dance", "literature", "novel", "symphony", "drama", "sculpture"],
    "science": ["science", "technology", "physics", "chemistry", "Einstein", "NASA", "experiment", "astronomy"],
    "arts_2": ["poetry", "art", "Shakespeare", "dance", "literature", "novel", "symphony", "drama"],
    "male_terms": ["male", "man", "boy", "brother", "he", "him", "his", "son"],
    "female_terms": ["female", "woman", "girl", "sister", "she", "her", "hers", "daughter"],
    "male_names_weat6": ["John", "Paul", "Mike", "Kevin", "Steve", "Greg", "Jeff", "Bill"],
    "female_names_weat6": ["Amy", "Joan", "Lisa", "Sarah", "Diana", "Kate", "Ann", "Donna"],
    "young_names": ["Tiffany", "Michelle", "Cindy", "Kristy", "Brad", "Eric", "Joey", "Billy"],
    "old_names": ["Ethel", "Bernice", "Gertrude", "Agnes", "Cecil", "Wilbert", "Mortimer", "Edgar"],
    "mental_disease": ["sad", "hopeless", "gloomy", "tearful", "miserable", "depressed"],
    "physical_disease": ["sick", "illness", "influenza", "disease", "virus", "cancer"],
    "temporary": ["impermanent", "unstable", "variable", "fleeting", "short-term", "brief", "occasional"],
    "permanent": ["stable", "always", "constant", "persistent", "chronic", "prolonged", "forever"]
  },
  "tests": [
    {"id": "weat6_gender_career", "targets": ["male_names_weat6", "female_names_weat6"], "attributes": ["career", "family"], "stereotypical_direction": "male-career"},
    {"id": "weat7_gender_math", "targets": ["math", "arts"], "attributes": ["male_terms", "female_terms"], "stereotypical_direction": "math-male"},
    {"id": "weat8_gender_science", "targets": ["science", "arts_2"], "attributes": ["male_terms", "female_terms"], "stereotypical_direction": "science-male"},
    {"id": "weat10_age_valence", "targets": ["young_names", "old_names"], "attributes": ["pleasant_short", "unpleasant_short"], "stereotypical_direction": "young-pleasant"}
  ],
  "notes": "Sets are transcribed from the published supplementary tables. The occupation sets used by the association battery live in occupations.json and are not part of the original stimuli."
}
